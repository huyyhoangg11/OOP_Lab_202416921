<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="175.0"
            prefWidth="305.0"
            style="-fx-border-color: #cfcfcf; -fx-border-width: 1; -fx-background-color: #f8f8f8;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml">

    <children>
        <VBox alignment="CENTER"
              prefHeight="175.0"
              prefWidth="305.0"
              spacing="10.0">

            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>

            <children>
                <Label fx:id="lblTitle"
                       alignment="CENTER"
                       prefHeight="50.0"
                       prefWidth="305.0"
                       text="Title"
                       wrapText="true"/>

                <Label fx:id="lblCost"
                       alignment="CENTER"
                       prefHeight="50.0"
                       prefWidth="305.0"
                       text="Cost"/>

                <HBox alignment="CENTER"
                      prefHeight="50.0"
                      prefWidth="305.0"
                      spacing="20.0">
                    <children>
                        <Button fx:id="btnAddToCart"
                                mnemonicParsing="false"
                                onAction="#btnAddToCartClicked"
                                text="Add to Cart"/>

                        <Button fx:id="btnPlay"
                                mnemonicParsing="false"
                                onAction="#btnPlayClicked"
                                text="Play"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>